# Required for Cursor SDK designs (same agent stack as the Cursor chatbox):
# Create a key at https://cursor.com/dashboard/integrations
CURSOR_API_KEY=

# Model id or alias served by Cursor SDK (CLI --model overrides this)
# Aliases: grok-4.5 (default), grok-4.6, claude, claude-opus, openai, composer
# Raw ids also work, e.g. claude-sonnet-5, gpt-5.4, composer-2.5
DESIGN_MODEL=grok-4.5

# draft = stop once CAD builds/renders (default, fast iteration)
# refine = full key-feature + physics review after each build
# DESIGN_MODE=draft

# Enable Cursor model fast mode (ModelSelection params fast=true)
# Also: python start_design.py --fast
# DESIGN_FAST=1

# auto | cursor | mock
# auto uses Cursor when CURSOR_API_KEY is set, otherwise mock
DESIGN_LLM=auto

# How many build→debug→rebuild cycles on CadQuery errors (default 5)
# DESIGN_DEBUG_RETRIES=5

# After a successful build: inspect source + multi-view RGB renders for
# requirements / physics, then refine and rebuild (default 3 review rounds)
# DESIGN_REVIEW_ROUNDS=3

# Max Cursor agent relaunches from context worksheet per send (default 3)
# DESIGN_AGENT_RECOVERIES=3

# Optional UI scale override for 4K / HiDPI (default auto-detects ~1.85 on 4K)
# DESIGN_UI_SCALE=2.0
